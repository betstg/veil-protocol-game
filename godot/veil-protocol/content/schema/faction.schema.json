{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "veil:faction",
  "title": "Faction",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name"],
  "properties": {
    "id":          { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "name":        { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "what":        { "type": "string" },
    "extra":       { "type": "object" }
  }
}
